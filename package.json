{
  "name": "workify",
  "version": "0.1.0",
  "scripts": {
    "dev": "node --env-file=.env scripts/dev.mjs",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "admin:bootstrap": "tsx --env-file=.env scripts/bootstrap-admin.ts",
    "db:local": "node --env-file=.env scripts/local-db.mjs",
    "worker": "tsx --env-file=.env scripts/reminders.ts",
    "test:integration": "node --env-file=.env scripts/test-integration.mjs",
    "dev:web": "next dev --hostname 127.0.0.1 --port 3000"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Avrasia Creative ajans çalışma alanı",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "argon2": "^0.45.1",
    "better-auth": "^1.7.10",
    "next": "^16.4.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "private": true,
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
